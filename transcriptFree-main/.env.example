# --- API Whisper (host persistente: Railway / Render / Fly / VPS) ---
# Não coloque segredos no frontend. Estas variáveis ficam só no servidor da API.

HOST=0.0.0.0
PORT=8000

# Origens da UI (Vercel). Separar por vírgula se houver mais de uma.
# Exemplo: https://seu-projeto.vercel.app
CORS_ORIGINS=

# Teto de upload em megabytes (recomendado 25 em API pública).
# MAX_UPLOAD_MB=25

# --- Build da UI na Vercel ---
# URL pública da API Whisper (sem barra no final).
# Exemplo: https://sua-api.up.railway.app
TRANSCRIPTOR_API_URL=
